generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  email            String            @unique
  name             String
  phone            String?
  walletAddress    String?
  id               String            @id @default(uuid())
  authId           String?
  picture          String?
  authProvider     String?
  audits           Audit[]           @relation("UserAudits")
  recyclingReports RecyclingReport[] @relation("UserRecyclingReport")
  userHistory      UserHistory[]     @relation("UserHistory")
  userRoles        UserRole[]        @relation("UserRoles")

  @@unique([authProvider, authId])
}

model Role {
  id    String     @id @default(uuid())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation("UserRoles", fields: [userId], references: [id])
}

model RecyclingReport {
  id              String   @id @default(uuid())
  submittedBy     String
  reportDate      DateTime @default(now())
  phone           String?
  materials       Json
  walletAddress   String?
  residueEvidence String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  metadata        Json?
  audits          Audit[]  @relation("ReportAudits")
  user            User     @relation("UserRecyclingReport", fields: [submittedBy], references: [id])
}

model Audit {
  id              String          @id @default(uuid())
  reportId        String
  auditorId       String?
  comments        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  status          AuditStatus     @default(PENDING)
  auditor         User?           @relation("UserAudits", fields: [auditorId], references: [id])
  recyclingReport RecyclingReport @relation("ReportAudits", fields: [reportId], references: [id])
}

model UserHistory {
  id                         String   @id @default(uuid())
  userId                     String
  totalResidueKgs            Float
  totalReports               Int
  timestamp                  DateTime @default(now())
  percentageChangeResidueKgs Float?
  percentageChangeReports    Float?
  user                       User     @relation("UserHistory", fields: [userId], references: [id])

  @@index([userId])
}

enum ResidueType {
  GLASS
  METAL
  ORGANIC
  PAPER
  PLASTIC
  TEXTILE
  LANDFILL_WASTE
}

enum AuditStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}
